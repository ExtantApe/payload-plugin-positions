{
  "name": "@extantape/payload-plugin-positions",
  "version": "0.0.0",
  "private": true,
  "description": "Positions for Payload: named roles people hold in an organization, for business accounts. A skeleton; the scope is still to come.",
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "positions",
    "roles",
    "organizations",
    "business-accounts",
    "access-control"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ExtantApe/payload-plugin-positions#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-positions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-positions.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
