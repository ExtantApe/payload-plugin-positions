    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@payloadcms/graphql": "^3.92.1",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
